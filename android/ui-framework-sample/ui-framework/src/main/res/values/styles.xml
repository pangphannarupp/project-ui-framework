<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Button -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/app_on_primary</item>
        <item name="cornerRadius">@dimen/app_radius_md</item>
        <item name="android:minHeight">@dimen/app_button_height_md</item>
    </style>

    <!-- Secondary Button -->
    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/app_secondary_container</item>
        <item name="android:textColor">@color/app_on_secondary_container</item>
        <item name="cornerRadius">@dimen/app_radius_md</item>
        <item name="android:minHeight">@dimen/app_button_height_md</item>
    </style>

    <!-- Outlined Button -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/app_outline</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="cornerRadius">@dimen/app_radius_md</item>
        <item name="android:minHeight">@dimen/app_button_height_md</item>
    </style>
</resources>
