<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="AppKhmerCalendarView">
        <attr name="akc_firstDayOfWeek" format="enum">
            <enum name="sunday" value="1" />
            <enum name="monday" value="2" />
            <enum name="tuesday" value="3" />
            <enum name="wednesday" value="4" />
            <enum name="thursday" value="5" />
            <enum name="friday" value="6" />
            <enum name="saturday" value="7" />
        </attr>
        <attr name="akc_showAdjacentMonths" format="boolean" />
        <attr name="akc_selectionMode" format="enum">
            <enum name="single" value="0" />
            <enum name="range" value="1" />
            <enum name="week" value="2" />
        </attr>
        <attr name="akc_extraWeeksBefore" format="integer" />
        <attr name="akc_extraWeeksAfter" format="integer" />
    </declare-styleable>
</resources>
